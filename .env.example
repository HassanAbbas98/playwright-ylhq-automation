# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored; `.env.example` is committed so collaborators know
# which keys to provide.

VALID_EMAIL=your-email@example.com
VALID_PASSWORD=your-password-here

# WP-Admin credentials for the AccuZip verification spec
# (tests/yellowletterhq/accuzip-verification.spec.js). These may match
# VALID_EMAIL/VALID_PASSWORD if the storefront user also has admin access
# (e.g. dev@yellowletterhq.com uses the same password for both).
WP_ADMIN_URL=https://www.yellowletterhq.com/wp-admin
WP_USER=dev@yellowletterhq.com
WP_PASS=your-wp-admin-password-here